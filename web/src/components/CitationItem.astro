---
import type { Citation } from "../lib/data";

interface Props {
  citation: Citation;
}

const { citation } = Astro.props;
const href = citation.url || (citation.doi ? `https://doi.org/${citation.doi}` : null);
const meta = [citation.authors, citation.year ? String(citation.year) : "", citation.venue]
  .filter((part) => part)
  .join(" · ");
const prov = citation.provenance;
const provTitle = prov.anchorTitle
  ? `Found via: ${prov.anchorTitle}`
  : prov.kind === "dataset"
    ? "This paper cited the dataset DOI directly"
    : prov.label;
---

<li class="cite">
  {
    href ? (
      <a class="cite__title" href={href} target="_blank" rel="noopener noreferrer">
        {citation.title}
      </a>
    ) : (
      <span class="cite__title">{citation.title}</span>
    )
  }
  {meta && <p class="cite__meta">{meta}</p>}
  <p class="cite__tags">
    <span class={`cite__flag cite__flag--${prov.kind}`} title={provTitle}>{prov.label}</span>
    {citation.citedBy > 0 && (
      <span class="cite__by">{citation.citedBy.toLocaleString("en-US")} citations</span>
    )}
  </p>
</li>

<style>
  .cite {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .cite__title {
    font-weight: var(--fw-medium);
    color: var(--color-fg);
  }
  a.cite__title:hover {
    color: var(--color-link-hover);
  }
  .cite__meta {
    margin-top: var(--space-1);
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
  }
  .cite__tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-2);
  }
  .cite__flag {
    display: inline-block;
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm, 4px);
    border: 1px solid transparent;
    cursor: help;
  }
  /* Cites a publication (data paper): the common case today. */
  .cite__flag--paper {
    color: var(--color-fg-muted);
    background: var(--color-bg-subtle);
    border-color: var(--color-border);
  }
  /* Cites the dataset's own DOI: highlighted (rare today, grows over time). */
  .cite__flag--dataset {
    color: var(--brand-teal);
    background: color-mix(in srgb, var(--brand-teal) 12%, transparent);
    border-color: color-mix(in srgb, var(--brand-teal) 35%, transparent);
  }
  .cite__by {
    font-size: var(--fs-xs);
    color: var(--color-fg-subtle);
  }
</style>
