---
/** Responsive SVG bar chart with gridlines, axis ticks, axis titles, bar
 * tooltips, and a visually-hidden data table for screen readers. */
import { compact, labelStride, niceTicks, withCommas } from "../lib/chart";

interface Props {
  bars: { label: string | number; value: number }[];
  xLabel: string;
  yLabel: string;
  ariaLabel: string;
  unit?: string;
}

const { bars, xLabel, yLabel, ariaLabel, unit = "" } = Astro.props;

const W = 860;
const H = 420;
const PAD = { top: 20, right: 24, bottom: 52, left: 66 };
const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

const maxY = bars.length ? Math.max(...bars.map((b) => b.value)) : 1;
const { ticks: yTicks, max: yMax } = niceTicks(maxY, 5);

const slot = bars.length ? plotW / bars.length : plotW;
const barW = Math.max(2, slot * 0.62);
const bx = (i: number) => PAD.left + i * slot + (slot - barW) / 2;
const sy = (y: number) => PAD.top + plotH - (yMax === 0 ? 0 : y / yMax) * plotH;
const xKeep = labelStride(bars.length, 8);
---

<figure class="chart-fig">
  {
    bars.length === 0 ? (
      <p class="chart-empty">No data available yet.</p>
    ) : (
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={ariaLabel} class="chart-svg">
        {yTicks.map((t) => (
          <g>
            <line class="grid" x1={PAD.left} x2={W - PAD.right} y1={sy(t)} y2={sy(t)} />
            <text class="tick" x={PAD.left - 10} y={sy(t)} text-anchor="end" dominant-baseline="middle">
              {compact(t)}
            </text>
          </g>
        ))}
        <line class="axis" x1={PAD.left} x2={PAD.left} y1={PAD.top} y2={PAD.top + plotH} />
        <line class="axis" x1={PAD.left} x2={W - PAD.right} y1={PAD.top + plotH} y2={PAD.top + plotH} />
        {bars.map((b, i) => (
          <rect
            class="bar"
            x={bx(i)}
            y={sy(b.value)}
            width={barW}
            height={PAD.top + plotH - sy(b.value)}
            rx="2"
          >
            <title>{`${b.label}: ${withCommas(b.value)}${unit ? ` ${unit}` : ""}`}</title>
          </rect>
        ))}
        {bars.map((b, i) =>
          xKeep.has(i) ? (
            <text class="tick" x={bx(i) + barW / 2} y={PAD.top + plotH + 20} text-anchor="middle">
              {b.label}
            </text>
          ) : null,
        )}
        <text class="axis-title" x={PAD.left + plotW / 2} y={H - 6} text-anchor="middle">
          {xLabel}
        </text>
        <text
          class="axis-title"
          transform={`translate(16 ${PAD.top + plotH / 2}) rotate(-90)`}
          text-anchor="middle"
        >
          {yLabel}
        </text>
      </svg>
    )
  }
  <table class="visually-hidden">
    <caption>{ariaLabel}</caption>
    <thead>
      <tr>
        <th>{xLabel}</th>
        <th>{yLabel}</th>
      </tr>
    </thead>
    <tbody>
      {
        bars.map((b) => (
          <tr>
            <td>{b.label}</td>
            <td>{withCommas(b.value)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</figure>

<style>
  .chart-fig {
    margin: 0;
  }
  .chart-svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .chart-empty {
    color: var(--color-fg-subtle);
    padding: var(--space-6);
  }
  .grid {
    stroke: var(--color-border);
    stroke-width: 1;
    opacity: 0.55;
  }
  .axis {
    stroke: var(--color-border-strong, var(--color-border));
    stroke-width: 1.25;
  }
  .tick {
    fill: var(--color-fg-subtle);
    font-size: 12px;
  }
  .axis-title {
    fill: var(--color-fg-muted);
    font-size: 13px;
    font-weight: var(--fw-medium);
  }
  .bar {
    fill: var(--brand-teal);
    opacity: 0.85;
    transition: opacity 0.12s ease;
  }
  .bar:hover {
    opacity: 1;
  }
</style>
