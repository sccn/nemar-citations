---
// Pure-SVG semantic scatter (no charting lib, matching the website's approach).
// Each node carries its real label as an SVG <title> (native hover tooltip).
interface MapPoint {
  x: number;
  y: number;
  label: string;
  size?: number;
}

interface Props {
  title: string;
  subtitle: string;
  points: MapPoint[];
}

const { title, subtitle, points } = Astro.props;

const W = 800;
const H = 600;
const PAD = 24;

const xs = points.map((p) => p.x);
const ys = points.map((p) => p.y);
const minX = xs.length ? Math.min(...xs) : 0;
const maxX = xs.length ? Math.max(...xs) : 1;
const minY = ys.length ? Math.min(...ys) : 0;
const maxY = ys.length ? Math.max(...ys) : 1;
const sx = (x: number) => PAD + (maxX === minX ? 0.5 : (x - minX) / (maxX - minX)) * (W - 2 * PAD);
// Flip y so larger values render upward, the usual scatter convention.
const sy = (y: number) =>
  H - PAD - (maxY === minY ? 0.5 : (y - minY) / (maxY - minY)) * (H - 2 * PAD);
---

<section class="map">
  <header class="map__head">
    <h3>{title}</h3>
    <p>{subtitle}</p>
  </header>
  <div class="map__body">
    {
      points.length === 0 ? (
        <p class="map__empty">No map data available yet.</p>
      ) : (
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title} preserveAspectRatio="xMidYMid meet">
          {points.map((p) => (
            <circle cx={sx(p.x)} cy={sy(p.y)} r={Math.max(2, p.size ?? 3)} class="dot">
              <title>{p.label}</title>
            </circle>
          ))}
        </svg>
      )
    }
  </div>
</section>

<style>
  .map {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-elevated);
  }
  .map__head {
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg-inverse);
    color: var(--color-fg-inverse);
  }
  .map__head h3 {
    font-size: var(--fs-lg);
    color: var(--color-fg-inverse);
  }
  .map__head p {
    margin-top: var(--space-1);
    font-size: var(--fs-sm);
    opacity: 0.85;
  }
  .map__body {
    padding: var(--space-3);
  }
  .map__empty {
    padding: var(--space-12) var(--space-4);
    text-align: center;
    color: var(--color-fg-subtle);
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .dot {
    fill: var(--brand-accent);
    fill-opacity: 0.7;
    stroke: var(--color-bg-elevated);
    stroke-width: 0.5;
  }
  .dot:hover {
    fill: var(--brand-electrode);
    fill-opacity: 1;
  }
</style>
