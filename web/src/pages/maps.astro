---
import InteractiveMap from "../components/InteractiveMap.astro";
import Base from "../layouts/Base.astro";
import { loadUmapPoints } from "../lib/maps";

const { datasets, citations } = loadUmapPoints();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const src = `${base}/maps/umap.json`;
---

<Base title="Network maps · NEMAR Citations">
  <p class="back"><a href={`${base}/`}>← Overview</a></p>
  <h1>Network maps</h1>
  <p class="sub">
    Datasets and citing papers positioned by semantic similarity (UMAP of their
    embeddings). Scroll to zoom, drag to pan, and click a point for details.
  </p>

  <div class="maps">
    <InteractiveMap
      title="Dataset map"
      subtitle="Datasets positioned by semantic coordinates"
      type="datasets"
      src={src}
      base={base}
      count={datasets.length}
    />
    <InteractiveMap
      title="Citation map"
      subtitle="Citing papers positioned by semantic coordinates"
      type="citations"
      src={src}
      base={base}
      count={citations.length}
    />
  </div>
</Base>

<style>
  .back {
    margin-bottom: var(--space-4);
    font-size: var(--fs-sm);
  }
  .sub {
    margin-top: var(--space-2);
    max-width: var(--max-width-prose);
    color: var(--color-fg-muted);
  }
  .maps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-6);
  }
</style>
