---
import LineChart from "../components/LineChart.astro";
import StatCard from "../components/StatCard.astro";
import Base from "../layouts/Base.astro";
import { loadAll } from "../lib/data";

const { overview, datasets, charts } = loadAll();
const fmt = (n: number) => n.toLocaleString("en-US");
const top = datasets.slice(0, 30);
const growth = charts.temporal.map((p) => ({ x: p.year, y: p.cumulative }));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const datasetLink = (id: string) => `${base}/dataset/${id}`;
---

<Base title="NEMAR Citations">
  <section class="hero">
    <h1>Dataset citations</h1>
    <p class="hero__sub">
      Citations tracked across NEMAR and OpenNeuro neuroscience datasets, scored for relevance
      and refreshed automatically from the NEMAR catalog.
    </p>
  </section>

  <section class="stats" aria-label="Overview statistics">
    <StatCard value={fmt(overview.datasetCount)} label="Datasets tracked" />
    <StatCard
      value={fmt(overview.uniqueCitations)}
      label="High-confidence citing papers"
      hint={`${fmt(overview.totalCitations)} attributions across datasets`}
    />
    <StatCard
      value={fmt(overview.datasetsWithCitations)}
      label="Datasets with high-confidence citations"
    />
  </section>
  <p class="stats-note">
    Counts include only high-confidence citations and exclude BIDS / methods /
    standards reference papers. {fmt(overview.lowConfidenceTotal)} lower-confidence
    citations are kept and shown per dataset.
  </p>

  <p class="maps-link">
    <a href={`${base}/maps`}>Explore the dataset &amp; citation maps →</a>
  </p>

  {
    growth.length > 0 && (
      <section class="chart-card">
        <header class="chart-card__head">
          <h2>Citation growth</h2>
          <p class="chart-card__cap">
            Cumulative high-confidence citing papers by year. <a href={`${base}/trends`}>See all trends →</a>
          </p>
        </header>
        <LineChart
          points={growth}
          xLabel="Year"
          yLabel="Cumulative papers"
          unit="papers"
          ariaLabel="Cumulative high-confidence citing papers by year"
        />
      </section>
    )
  }

  <section class="browse">
    <h2>Most-cited datasets</h2>
    <ol class="ds-list" role="list">
      {
        top.map((d) => (
          <li class="ds">
            <a class="ds__name" href={datasetLink(d.id)}>
              {d.name}
            </a>
            <span class="ds__id">{d.id}</span>
            <span class="ds__count">{fmt(d.numCitations)}</span>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-8);
  }
  .hero__sub {
    max-width: var(--max-width-prose);
    color: var(--color-fg-muted);
    font-size: var(--fs-lg);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-5);
  }
  .stats-note {
    margin-top: var(--space-3);
    max-width: var(--max-width-prose);
    font-size: var(--fs-sm);
    color: var(--color-fg-subtle);
  }
  .maps-link {
    margin-top: var(--space-6);
    font-weight: var(--fw-medium);
  }
  .chart-card {
    margin-top: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    background: var(--color-bg-elevated);
  }
  .chart-card__head {
    margin-bottom: var(--space-4);
  }
  .chart-card__head h2 {
    font-size: var(--fs-lg);
  }
  .chart-card__cap {
    margin-top: var(--space-1);
    font-size: var(--fs-sm);
    color: var(--color-fg-subtle);
  }
  .browse {
    margin-top: var(--space-12);
  }
  .browse h2 {
    margin-bottom: var(--space-4);
  }
  .ds-list {
    list-style: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .ds {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .ds:last-child {
    border-bottom: none;
  }
  .ds:hover {
    background: var(--color-bg-subtle);
  }
  .ds__name {
    font-weight: var(--fw-medium);
    color: var(--color-fg);
  }
  .ds__id {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--color-fg-subtle);
  }
  .ds__count {
    font-variant-numeric: tabular-nums;
    font-weight: var(--fw-semibold);
    color: var(--brand-teal);
  }
</style>
