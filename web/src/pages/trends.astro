---
import BarChart from "../components/BarChart.astro";
import DonutChart from "../components/DonutChart.astro";
import LineChart from "../components/LineChart.astro";
import Base from "../layouts/Base.astro";
import { loadAll } from "../lib/data";
import { MODALITY_META, MODALITY_ORDER, loadModalities } from "../lib/modality";

const { charts, overview, datasets } = loadAll();
const fmt = (n: number) => n.toLocaleString("en-US");

const linePoints = charts.temporal.map((p) => ({ x: p.year, y: p.cumulative }));
const bars = charts.temporal.map((p) => ({ label: p.year, value: p.newPapers }));
const latest = charts.temporal.length ? charts.temporal[charts.temporal.length - 1].cumulative : 0;
const confSlices = [
  { label: "High-confidence (≥ 0.4)", value: charts.confidence.high, color: "var(--brand-teal)" },
  {
    label: "Lower-confidence (< 0.4)",
    value: charts.confidence.low,
    color: "var(--color-fg-subtle)",
  },
];

// Modality breakdown of the tracked datasets, joined from the api.nemar.org catalog.
const modalities = loadModalities();
const modCounts = new Map<string, number>();
for (const d of datasets) {
  const m = modalities.get(d.id) ?? "other";
  modCounts.set(m, (modCounts.get(m) ?? 0) + 1);
}
const modSlices = MODALITY_ORDER.filter((m) => modCounts.get(m)).map((m) => ({
  label: MODALITY_META[m].label,
  value: modCounts.get(m) ?? 0,
  color: MODALITY_META[m].color,
}));
---

<Base title="Citation trends · NEMAR Citations">
  <h1>Citation trends</h1>
  <p class="sub">
    How citations of NEMAR and OpenNeuro datasets have accumulated over time. The growth
    charts count unique high-confidence citing papers ({fmt(overview.uniqueCitations)} to date,
    matching the overview); the confidence chart counts per-dataset attributions.
  </p>

  <section class="chart-card">
    <header class="chart-card__head">
      <h2>Cumulative citation growth</h2>
      <p class="chart-card__cap">
        Unique high-confidence citing papers through each year ({fmt(latest)} with a known year).
      </p>
    </header>
    <LineChart
      points={linePoints}
      xLabel="Year"
      yLabel="Cumulative papers"
      unit="papers"
      ariaLabel="Cumulative high-confidence citing papers by year"
    />
  </section>

  <div class="chart-grid">
    <section class="chart-card">
      <header class="chart-card__head">
        <h2>New citations per year</h2>
        <p class="chart-card__cap">High-confidence citing papers first published each year.</p>
      </header>
      <BarChart
        bars={bars}
        xLabel="Year"
        yLabel="Papers"
        unit="papers"
        ariaLabel="New high-confidence citing papers per year"
      />
    </section>

    <section class="chart-card">
      <header class="chart-card__head">
        <h2>Citation confidence</h2>
        <p class="chart-card__cap">
          Confidence split of citation-dataset attributions: the same paper citing several
          datasets counts once per dataset. Methods papers excluded.
        </p>
      </header>
      <DonutChart
        slices={confSlices}
        centerLabel="attributions"
        ariaLabel="Confidence split of citation-dataset attributions"
      />
    </section>

    {
      modSlices.length > 0 && (
        <section class="chart-card">
          <header class="chart-card__head">
            <h2>Datasets by modality</h2>
            <p class="chart-card__cap">
              Recording modality of the tracked datasets (from the NEMAR catalog).
            </p>
          </header>
          <DonutChart
            slices={modSlices}
            centerLabel="datasets"
            ariaLabel="Tracked datasets by recording modality"
          />
        </section>
      )
    }
  </div>
</Base>

<style>
  .sub {
    margin-top: var(--space-2);
    max-width: var(--max-width-prose);
    color: var(--color-fg-muted);
  }
  .chart-card {
    margin-top: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    background: var(--color-bg-elevated);
  }
  .chart-card__head {
    margin-bottom: var(--space-4);
  }
  .chart-card__head h2 {
    font-size: var(--fs-lg);
  }
  .chart-card__cap {
    margin-top: var(--space-1);
    font-size: var(--fs-sm);
    color: var(--color-fg-subtle);
    max-width: var(--max-width-prose);
  }
  .chart-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: var(--space-5);
  }
</style>
