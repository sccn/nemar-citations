---
import BarChart from "../components/BarChart.astro";
import DonutChart from "../components/DonutChart.astro";
import LineChart from "../components/LineChart.astro";
import Base from "../layouts/Base.astro";
import { loadAll } from "../lib/data";

const { charts, overview } = loadAll();
const fmt = (n: number) => n.toLocaleString("en-US");

const linePoints = charts.temporal.map((p) => ({ x: p.year, y: p.cumulative }));
const bars = charts.temporal.map((p) => ({ label: p.year, value: p.newPapers }));
const latest = charts.temporal.length ? charts.temporal[charts.temporal.length - 1].cumulative : 0;
const confSlices = [
  { label: "High-confidence (≥ 0.4)", value: charts.confidence.high, color: "var(--brand-teal)" },
  {
    label: "Lower-confidence (< 0.4)",
    value: charts.confidence.low,
    color: "var(--color-fg-subtle)",
  },
];
---

<Base title="Citation trends · NEMAR Citations">
  <h1>Citation trends</h1>
  <p class="sub">
    How citations of NEMAR and OpenNeuro datasets have accumulated over time. Counts
    match the overview: {fmt(overview.uniqueCitations)} unique high-confidence citing papers.
  </p>

  <section class="chart-card">
    <header class="chart-card__head">
      <h2>Cumulative citation growth</h2>
      <p class="chart-card__cap">
        Unique high-confidence citing papers through each year ({fmt(latest)} with a known year).
      </p>
    </header>
    <LineChart
      points={linePoints}
      xLabel="Year"
      yLabel="Cumulative papers"
      unit="papers"
      ariaLabel="Cumulative high-confidence citing papers by year"
    />
  </section>

  <div class="chart-grid">
    <section class="chart-card">
      <header class="chart-card__head">
        <h2>New citations per year</h2>
        <p class="chart-card__cap">High-confidence citing papers first published each year.</p>
      </header>
      <BarChart
        bars={bars}
        xLabel="Year"
        yLabel="Papers"
        unit="papers"
        ariaLabel="New high-confidence citing papers per year"
      />
    </section>

    <section class="chart-card">
      <header class="chart-card__head">
        <h2>Citation confidence</h2>
        <p class="chart-card__cap">
          Confidence split of citation-dataset attributions (methods papers excluded).
        </p>
      </header>
      <DonutChart
        slices={confSlices}
        centerLabel="attributions"
        ariaLabel="Confidence split of citation-dataset attributions"
      />
    </section>
  </div>
</Base>

<style>
  .sub {
    margin-top: var(--space-2);
    max-width: var(--max-width-prose);
    color: var(--color-fg-muted);
  }
  .chart-card {
    margin-top: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    background: var(--color-bg-elevated);
  }
  .chart-card__head {
    margin-bottom: var(--space-4);
  }
  .chart-card__head h2 {
    font-size: var(--fs-lg);
  }
  .chart-card__cap {
    margin-top: var(--space-1);
    font-size: var(--fs-sm);
    color: var(--color-fg-subtle);
    max-width: var(--max-width-prose);
  }
  .chart-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: var(--space-5);
  }
</style>
