---
import CitationItem from "../../components/CitationItem.astro";
import Base from "../../layouts/Base.astro";
import { type DatasetDetail, loadAll } from "../../lib/data";

export function getStaticPaths() {
  const { datasets } = loadAll();
  return datasets.map((dataset) => ({ params: { id: dataset.id }, props: { dataset } }));
}

interface Props {
  dataset: DatasetDetail;
}

const { dataset } = Astro.props;
const fmt = (n: number) => n.toLocaleString("en-US");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title={`${dataset.name} — citations`}>
  <p class="back"><a href={`${base}/`}>← All datasets</a></p>
  <h1 class="ds-title">{dataset.name}</h1>
  <p class="ds-sub">
    <span class="ds-sub__id">{dataset.id}</span> · {fmt(dataset.numCitations)} citations
  </p>

  <ol class="cites" role="list">
    {dataset.citations.map((citation) => <CitationItem citation={citation} />)}
  </ol>
</Base>

<style>
  .back {
    margin-bottom: var(--space-4);
    font-size: var(--fs-sm);
  }
  .ds-title {
    font-size: var(--fs-3xl);
  }
  .ds-sub {
    margin-top: var(--space-2);
    color: var(--color-fg-muted);
  }
  .ds-sub__id {
    font-family: var(--font-mono);
  }
  .cites {
    list-style: none;
    margin-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
</style>
